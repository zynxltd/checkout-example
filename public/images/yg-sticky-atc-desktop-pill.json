/**
 * Crazy Egg — PDP sticky ATC: max-width condensed bar (~485px)
 *
 * 600px wide and above. Hidden on phone.
 * Shows once #plantcalendar is on screen and the live buy button
 * is off screen. Hides when the site footer enters the screen.
 * Floating 485px box, centered at the bottom of the viewport.
 *
 * Paste into Crazy Egg Variant → Custom JS
 * Pair with: yg-sticky-atc-desktop-pill.css
 */
(function () {
  'use strict';

  var BAR_ID = 'ce-yg-atb-p';
  var ON = 'ce-yg-atb-p-on';
  var READY = 'ce-yg-atb-p-ready';
  var STYLE_ID = 'ce-yg-atb-p-css';
  var WIDE = 600;
  var MOVE_TOP = true;
  var TOP_GAP = 36;
  var bar = null;
  var started = false;
  var parkTimer = null;

  function qs(sel, root) {
    return (root || document).querySelector(sel);
  }
  function isWide() { return window.innerWidth >= WIDE; }
  function buyButton() {
    return document.getElementById('buy-button')
      || qs('.product-right-wrapper .buy-wrapper > .buy-button')
      || qs('.buy-wrapper > .buy-button')
      || qs('.product-right-wrapper .buy-button');
  }
  function hasOptions() { return !!qs('#style-options-drop-box .option-row'); }
  function activeOption() { return qs('#style-options-drop-box .option-row.active:not(.discont)'); }
  function buttonOffscreen(el) {
    var r = el.getBoundingClientRect();
    if (!r || (r.width === 0 && r.height === 0)) return true;
    return r.bottom < 8 || r.top > window.innerHeight - 8;
  }
  function footerReached() {
    var footer = qs('.footerMiddle') || qs('footer');
    if (!footer) return false;
    var r = footer.getBoundingClientRect();
    if (!r || (r.width === 0 && r.height === 0)) return false;
    return r.top < window.innerHeight;
  }
  function calendarReached() {
    var el = document.getElementById('plantcalendar');
    if (!el) return true;
    var r = el.getBoundingClientRect();
    if (!r || (r.width === 0 && r.height === 0)) return false;
    return r.top < window.innerHeight - 24;
  }
  function headerBottom() {
    var nodes = [document.getElementById('head-scroll'), document.getElementById('header'), qs('header')];
    var bottom = 0, i, el, rect, pos, seen = [];
    for (i = 0; i < nodes.length; i++) {
      el = nodes[i];
      if (!el || seen.indexOf(el) !== -1) continue;
      seen.push(el);
      rect = el.getBoundingClientRect();
      if (!rect || (rect.width === 0 && rect.height === 0)) continue;
      pos = window.getComputedStyle(el).position;
      if ((pos === 'fixed' || pos === 'sticky') && rect.top < 80 && rect.bottom > bottom) bottom = rect.bottom;
    }
    return Math.max(0, Math.round(bottom));
  }
  function headerGap() { return Math.max(8, headerBottom()); }
  function productName() {
    var h1 = qs('.product-heading-wrapper h1') || qs('h1');
    return h1 ? String(h1.textContent || '').replace(/\s+/g, ' ').trim() : '';
  }
  function productImage() {
    var img = qs('.slick-current.slick-active img.mainImg') || qs('img.mainImg');
    if (img) return img.currentSrc || img.src || '';
    var og = qs('meta[property="og:image"]');
    return og ? og.getAttribute('content') || '' : '';
  }
  function packLabel() {
    var row = activeOption();
    if (!row) return '';
    var title = qs('.title', row);
    if (!title) return '';
    var clone = title.cloneNode(true);
    var sku = qs('.sku', clone);
    if (sku && sku.parentNode) sku.parentNode.removeChild(sku);
    return String(clone.textContent || '').replace(/\s+/g, ' ').trim();
  }

  function packSize() {
    var wrap = qs('.price-wrapper .pno-wrapper');
    if (!wrap) return '';
    var clone = wrap.cloneNode(true);
    var drop = clone.querySelectorAll('.pno, .pipe');
    var i;
    for (i = 0; i < drop.length; i++) {
      if (drop[i].parentNode) drop[i].parentNode.removeChild(drop[i]);
    }
    return String(clone.textContent || '').replace(/\s+/g, ' ').replace(/\|/g, '').trim();
  }
  function priceLabel() {
    var row = activeOption();
    var span;
    if (row) {
      span = qs('.price > span', row) || qs('.price span', row);
      if (span) return String(span.textContent || '').replace(/\s+/g, ' ').trim();
    }
    span = qs('#main-from-price .price-text');
    if (span) {
      var from = String(span.textContent || '').replace(/\s+/g, ' ').trim();
      return from ? 'From ' + from : '';
    }
    span = qs('.price-wrapper .price .price-text') || qs('.product-right-wrapper .price .price-text');
    if (span) return String(span.textContent || '').replace(/\s+/g, ' ').trim();
    return '';
  }

  function fill(node) {
    var img = qs('.ce-yg-atb-p__img', node);
    var title = qs('.ce-yg-atb-p__title', node);
    var sub = qs('.ce-yg-atb-p__sub', node);
    var price = qs('.ce-yg-atb-p__price', node);
    var src = productImage();
    var name = productName();
    var pack = packLabel();
    var options = hasOptions();
    if (img) { if (src) img.src = src; img.alt = name; }
    node.classList.toggle('is-no-img', !src);
    node.classList.toggle('is-no-options', !options);
    if (title) title.textContent = pack || name || 'Add to basket';
    if (sub) sub.textContent = pack ? name : (options ? 'Choose an option' : packSize());
    if (price) price.textContent = priceLabel();
  }

  function offerBadges() { return document.querySelectorAll('[id$="__notification"]'); }
  function parkOfferBadges(hide) {
    var nodes = offerBadges(), i, node;
    for (i = 0; i < nodes.length; i++) {
      node = nodes[i];
      if (hide) {
        if (node.getAttribute('data-ce-yg-atb-p-parked') === '1' && node.style.display === 'none') continue;
        node.setAttribute('data-ce-yg-atb-p-parked', '1');
        node.style.setProperty('display', 'none', 'important');
        node.style.setProperty('visibility', 'hidden', 'important');
        node.style.setProperty('pointer-events', 'none', 'important');
        continue;
      }
      if (node.getAttribute('data-ce-yg-atb-p-parked') !== '1') continue;
      node.style.removeProperty('display');
      node.style.removeProperty('visibility');
      node.style.removeProperty('pointer-events');
      node.removeAttribute('data-ce-yg-atb-p-parked');
    }
  }
  function placeScrollTop(barHeight) {
    var el = document.getElementById('return-to-top');
    if (!el || !MOVE_TOP) return;
    if (!barHeight) {
      if (el.getAttribute('data-ce-yg-atb-p-top') === '1') {
        el.style.removeProperty('bottom');
        el.style.removeProperty('right');
        el.removeAttribute('data-ce-yg-atb-p-top');
      }
      return;
    }
    el.setAttribute('data-ce-yg-atb-p-top', '1');
    el.style.setProperty('bottom', Math.round(barHeight + TOP_GAP) + 'px', 'important');
    el.style.setProperty('right', '16px', 'important');
  }
  function clearOfferChrome(hide, barHeight) {
    if (parkTimer) { window.clearInterval(parkTimer); parkTimer = null; }
    parkOfferBadges(hide);
    placeScrollTop(barHeight);
    window.requestAnimationFrame(function () {
      var open = document.documentElement.classList.contains(ON) && bar && bar.offsetHeight;
      parkOfferBadges(!!open);
      placeScrollTop(open ? bar.offsetHeight : 0);
    });
    if (!hide) return;
    parkTimer = window.setInterval(function () {
      if (!document.documentElement.classList.contains(ON) || !bar) return;
      parkOfferBadges(true);
      placeScrollTop(bar.offsetHeight);
    }, 250);
  }

  function layout(node) {
    node.style.setProperty('position', 'fixed', 'important');
    node.style.setProperty('left', '50%', 'important');
    node.style.setProperty('right', 'auto', 'important');
    node.style.setProperty('top', 'auto', 'important');
    node.style.setProperty('bottom', '20px', 'important');
    node.style.setProperty('width', '485px', 'important');
    node.style.setProperty('max-width', 'calc(100vw - 24px)', 'important');
    node.style.setProperty('z-index', '2147483000', 'important');
    node.style.setProperty('box-sizing', 'border-box', 'important');
    node.style.setProperty('display', isWide() ? 'flex' : 'none', 'important');
  }
  function paint(node, show) {
    fill(node);
    layout(node);
    document.documentElement.classList.toggle(ON, show);
    node.setAttribute('aria-hidden', show ? 'false' : 'true');
    if (show) {
      var height = node.offsetHeight;
      document.documentElement.style.setProperty('--ce-yg-atb-p-h', height + 'px');
      document.documentElement.style.setProperty('padding-bottom', (height + 28) + 'px', 'important');
      clearOfferChrome(true, height);
    } else {
      document.documentElement.style.removeProperty('--ce-yg-atb-p-h');
      document.documentElement.style.removeProperty('padding-bottom');
      clearOfferChrome(false, 0);
    }
  }

  function scrollOptionsIntoView() {
    var price = document.getElementById('main-from-price');
    var options = document.getElementById('style-options')
      || document.getElementById('style-options-head')
      || document.getElementById('style-options-drop-box');
    var target = price || options || document.getElementById('buy-button-wrapper') || buyButton();
    if (!target) return;
    var extra = bar && bar.offsetHeight && BAR_ID === 'ce-yg-atb-t' ? bar.offsetHeight + 16 : (price ? 20 : 72);
    var gap = headerGap() + extra;
    var top = window.pageYOffset + target.getBoundingClientRect().top - gap;
    window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
  }
  function openOptions() {
    if (typeof window.showOptions === 'function') window.showOptions();
    else { var live = buyButton(); if (live) live.click(); }
    window.setTimeout(scrollOptionsIntoView, 60);
    window.setTimeout(scrollOptionsIntoView, 320);
  }
  function addToBasket() {
    var live = buyButton();
    if (hasOptions() && !activeOption()) { openOptions(); return; }
    if (live) live.click();
  }

  function injectCss() {
    if (document.getElementById(STYLE_ID)) return;
    var css = '@media (min-width:600px){' +
        '.ce-yg-atb-p{position:fixed!important;left:50%!important;right:auto!important;bottom:20px!important;top:auto!important;z-index:2147483000!important;display:none;width:485px;max-width:calc(100vw - 24px);padding:12px 14px;transform:translateX(-50%) translateY(16px);border:1px solid #e2e2e2;border-radius:14px!important;background:#fff;box-shadow:0 8px 22px rgba(0,0,0,.18);font-family:Arial,Helvetica,sans-serif;pointer-events:none;visibility:hidden}' +
        'html.ce-yg-atb-p-on .ce-yg-atb-p{display:flex!important;align-items:center;gap:12px;transform:translateX(-50%) translateY(0);visibility:visible;pointer-events:auto}' +
        'html.ce-yg-atb-p-ready .ce-yg-atb-p{display:flex!important;transition:transform .28s ease-out,visibility .28s ease-out}' +
        '.ce-yg-atb-p__img{display:block;flex:0 0 64px;width:64px;height:64px;object-fit:cover;border-radius:8px;background:#f3f3f3}' +
        '.ce-yg-atb-p.is-no-img .ce-yg-atb-p__img{display:none}' +
        '.ce-yg-atb-p__main{flex:1 1 auto;min-width:0;display:flex;flex-direction:column;gap:8px}' +
        '.ce-yg-atb-p__copy{display:grid;grid-template-columns:minmax(0,1fr) auto;column-gap:10px;row-gap:2px}' +
        '.ce-yg-atb-p__title{grid-column:1;font-size:14px;font-weight:700;color:#222;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}' +
        '.ce-yg-atb-p__sub{grid-column:1;font-size:12px;color:#666;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}' +
        '.ce-yg-atb-p__price{grid-column:2;grid-row:1 / span 2;font-size:18px;font-weight:700;color:#e3185d;white-space:nowrap}' +
        '.ce-yg-atb-p__actions{display:flex;gap:8px}' +
        '.ce-yg-atb-p__options,.ce-yg-atb-p__buy{flex:1 1 0;box-sizing:border-box;display:flex;align-items:center;justify-content:center;height:40px;margin:0;padding:0 10px;border-radius:10px!important;font:700 13px/1 Arial,Helvetica,sans-serif;cursor:pointer}' +
        '.ce-yg-atb-p__options{border:1px solid #468900;background:#fff;color:#468900}' +
        '.ce-yg-atb-p.is-no-options .ce-yg-atb-p__options{display:none}' +
        '.ce-yg-atb-p__buy{border:0;background:#468900;color:#fff;text-transform:uppercase}' +
        'html.ce-yg-atb-p-on [id$="__notification"]{display:none!important}' +
      '}' +
      '@media (max-width:599px){.ce-yg-atb-p{display:none!important}}';
    var style = document.createElement('style');
    style.id = STYLE_ID;
    style.appendChild(document.createTextNode(css));
    document.head.appendChild(style);
  }
  function build() {
    if (document.getElementById(BAR_ID)) return document.getElementById(BAR_ID);
    injectCss();
    var node = document.createElement('div');
    node.id = BAR_ID;
    node.className = 'ce-yg-atb-p';
    node.setAttribute('role', 'region');
    node.setAttribute('aria-label', 'Add to basket');
    node.innerHTML = '<img class="ce-yg-atb-p__img" alt="">' +
      '<div class="ce-yg-atb-p__main">' +
        '<div class="ce-yg-atb-p__copy">' +
          '<div class="ce-yg-atb-p__title"></div>' +
          '<div class="ce-yg-atb-p__sub"></div>' +
          '<div class="ce-yg-atb-p__price"></div>' +
        '</div>' +
        '<div class="ce-yg-atb-p__actions">' +
          '<button type="button" class="ce-yg-atb-p__options">Show options</button>' +
          '<button type="button" class="ce-yg-atb-p__buy">Add to basket</button>' +
        '</div>' +
      '</div>';
    qs('.ce-yg-atb-p__options', node).addEventListener('click', openOptions);
    qs('.ce-yg-atb-p__buy', node).addEventListener('click', addToBasket);
    document.body.appendChild(node);
    paint(node, false);
    window.setTimeout(function () { document.documentElement.classList.add(READY); }, 50);
    return node;
  }

  function tick() {
    var live = buyButton();
    if (!isWide() || !live) { if (bar) paint(bar, false); return; }
    if (!bar) bar = build();
    paint(bar, buttonOffscreen(live) && calendarReached() && !footerReached());
  }
  function arm() {
    if (started) return;
    if (!buyButton()) return;
    started = true;
    tick();
    window.addEventListener('scroll', tick, { passive: true });
    window.addEventListener('resize', tick);
    if (window.visualViewport) {
      window.visualViewport.addEventListener('resize', tick);
      window.visualViewport.addEventListener('scroll', tick);
    }
  }
  function boot() {
    injectCss();
    arm();
    var tries = 0;
    var timer = setInterval(function () {
      tries += 1;
      arm();
      tick();
      if (started && tries > 8) clearInterval(timer);
      if (tries > 40) clearInterval(timer);
    }, 250);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();

})();
