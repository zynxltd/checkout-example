<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> — <%= appName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Syne:wght@600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="shell header-row">
      <a class="brand" href="/"><%= appName %></a>
      <nav class="nav">
        <a href="/" class="<%= currentPath === '/' ? 'is-active' : '' %>">Home</a>
        <a href="/products" class="<%= currentPath.startsWith('/products') ? 'is-active' : '' %>">Products</a>
        <a href="/about" class="<%= currentPath === '/about' ? 'is-active' : '' %>">About</a>
        <a href="/dashboard" class="<%= currentPath.startsWith('/dashboard') ? 'is-active' : '' %>">Dashboard</a>
        <% if (isAuthenticated) { %>
          <form method="post" action="/logout" class="nav-inline">
            <button type="submit" class="nav-link-button"><%= currentUser.email %> · Sign out</button>
          </form>
        <% } else { %>
          <a href="/login" class="<%= currentPath === '/login' ? 'is-active' : '' %>">Login</a>
        <% } %>
        <a class="nav-cta" href="/contact">Contact</a>
      </nav>
    </div>
  </header>
  <main id="main">
