@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy";
    ViewData["Description"] = "Northline privacy policy.";
}

<section class="page-hero">
    <div class="shell">
        <h1>Privacy</h1>
        <p>How we handle information you share with Northline.</p>
    </div>
</section>

<section class="section">
    <div class="shell prose reveal" style="max-width:42rem">
        <p>This is a demonstration site. Contact form submissions are validated in-memory and are not stored or emailed.</p>
        <p>In a production deployment, Northline would collect only what is needed to respond to enquiries, keep it secure, and never sell it. You could request deletion of enquiry records at any time by emailing hello@northline.example.</p>
        <p>We do not use analytics cookies on this demo. Third-party fonts may be loaded from Google Fonts when you visit the site.</p>
    </div>
</section>
