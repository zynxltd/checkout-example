@page
@model AboutModel
@{
    ViewData["Title"] = "About";
    ViewData["Description"] = "About Northline — a digital product studio.";
}

<section class="page-hero">
    <div class="shell">
        <h1>About Northline</h1>
        <p>A compact studio with senior craft across product, design, and .NET engineering.</p>
    </div>
</section>

<section class="section">
    <div class="shell split">
        <div class="prose reveal">
            <p>Northline started as a bet that the best digital work happens when strategy, design, and engineering share one brief — not a relay race of handoffs.</p>
            <p>We keep the team small on purpose. You’ll work with people who can sketch a journey in the morning and ship an ASP.NET Core endpoint in the afternoon.</p>
            <p>We’re based in the UK and collaborate with product teams across retail, membership, and B2B services.</p>
        </div>
        <ul class="feature-list reveal">
            <li>
                <h3>Principles</h3>
                <p>Clarity over novelty. Evidence over opinion. Ship in weeks, not quarters of theatre.</p>
            </li>
            <li>
                <h3>How we work</h3>
                <p>Fixed discovery sprints, transparent burn-down, and demos you can click — not slide decks alone.</p>
            </li>
            <li>
                <h3>Stack</h3>
                <p>ASP.NET Core, Razor Pages / Blazor, modern CSS, and the front-end tools your team already trusts.</p>
            </li>
        </ul>
    </div>
</section>
