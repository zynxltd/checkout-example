<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Northline</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Northline designs and builds digital products for ambitious teams.")" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Syne:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header" data-header>
        <div class="shell header-inner">
            <a class="brand" asp-page="/Index" aria-label="Northline home">
                <span class="brand-mark" aria-hidden="true"></span>
                Northline
            </a>
            <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="site-nav">
                <span class="sr-only">Menu</span>
                <span></span><span></span>
            </button>
            <nav id="site-nav" class="site-nav" data-nav>
                <a asp-page="/Index">Home</a>
                <a asp-page="/About">About</a>
                <a asp-page="/Services">Services</a>
                <a class="nav-cta" asp-page="/Contact">Contact</a>
            </nav>
        </div>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="shell footer-grid">
            <div>
                <p class="footer-brand">Northline</p>
                <p class="footer-copy">Digital product studio. Strategy, design, and engineering under one roof.</p>
            </div>
            <div class="footer-links">
                <a asp-page="/About">About</a>
                <a asp-page="/Services">Services</a>
                <a asp-page="/Contact">Contact</a>
                <a asp-page="/Privacy">Privacy</a>
            </div>
        </div>
        <div class="shell footer-meta">
            <span>&copy; @DateTime.UtcNow.Year Northline</span>
            <span>Built with ASP.NET Core</span>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
