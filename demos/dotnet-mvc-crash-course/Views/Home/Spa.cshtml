@{
    ViewData["Title"] = "Products SPA";
}

<h1 class="h3">Products API (JS)</h1>
<p class="text-muted small">Path A SPA — <code>wwwroot/js/products-api.js</code> calls <code>/api/products</code>.</p>

<div id="products-root" class="mb-4">Loading…</div>

<form id="create-form" class="col-lg-5 card card-body">
    <h2 class="h6">Add via fetch</h2>
    <div class="mb-2"><input class="form-control" name="sku" placeholder="SKU" required /></div>
    <div class="mb-2"><input class="form-control" name="name" placeholder="Name" required /></div>
    <div class="mb-2"><input class="form-control" name="category" placeholder="Category" required /></div>
    <div class="mb-2"><input class="form-control" name="price" type="number" step="0.01" placeholder="Price" required /></div>
    <div class="mb-2"><input class="form-control" name="stock" type="number" placeholder="Stock" required /></div>
    <button class="btn btn-primary" type="submit">Create</button>
</form>

@section Scripts {
    <script src="~/js/products-api.js" asp-append-version="true"></script>
}
