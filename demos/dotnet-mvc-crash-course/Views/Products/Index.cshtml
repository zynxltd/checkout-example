@model IEnumerable<DotnetMvcCrashCourse.Models.Product>
@{
    ViewData["Title"] = "Products";
    string? category = ViewBag.Category as string;
    string? q = ViewBag.Q as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Products</h1>
        <p class="text-muted small mb-0">MVC list — Laravel: <code>ProductController@index</code> + Blade</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Add product</a>
</div>

@if (TempData["Flash"] is string flash)
{
    <div class="alert alert-success">@flash</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input class="form-control" name="category" value="@category" placeholder="category (plants)" />
    </div>
    <div class="col-auto">
        <input class="form-control" name="q" value="@q" placeholder="search name/sku" />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary" type="submit">Filter</button>
        <a class="btn btn-link" asp-action="Index">Clear</a>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
    <tr>
        <th>SKU</th>
        <th>Name</th>
        <th>Category</th>
        <th class="text-end">Price</th>
        <th class="text-end">Stock</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td><code>@p.Sku</code></td>
            <td>@p.Name</td>
            <td><span class="badge text-bg-light">@p.Category</span></td>
            <td class="text-end">£@p.Price.ToString("0.00")</td>
            <td class="text-end">@p.Stock</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@p.Id">View</a>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.Id">Edit</a>
                <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline"
                      onsubmit="return confirm('Delete @p.Name?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
